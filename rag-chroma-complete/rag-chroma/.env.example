# Copy to .env. Never commit your real key.
OPENAI_API_KEY=
# Replace with a Responses API model available to your account if needed.
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=./storage/chroma
COLLECTION_NAME=knowledge_base
CHUNK_SIZE=1600
CHUNK_OVERLAP=200
TOP_K=5
# Optional cosine distance cutoff, 0..2. Blank = no cutoff.
# This is NOT a probability. Calibrate on your own evaluation set.
MAX_DISTANCE=
CONTEXT_MAX_CHARS=12000
MAX_OUTPUT_TOKENS=1200
# Optional shared local-demo API token; not multi-user authorization.
APP_API_KEY=
RAG_API_URL=http://127.0.0.1:8000
